---
import AuthGate from "../components/AuthGate.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Rezepte", description = "Öffentliche Rezepte aus dem Second Brain." } =
  Astro.props;
const pageTitle = title === "Rezepte" ? "Rezepte" : `${title} · Rezepte`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow,noarchive,noimageindex" />
    <title>{pageTitle}</title>
  </head>
  <body class="auth-pending" data-auth-state="pending">
    <AuthGate />
    <div class="auth-content" data-auth-content aria-hidden="true">
      <slot />
      <footer class="site-footer" aria-label="Rechtlicher Hinweis">
        <p>
          Privates, nicht kommerzielles Rezeptarchiv ohne Einnahmen. Urheber- und Nutzungsrechte verbleiben bei den
          jeweiligen Rechteinhabern.
        </p>
      </footer>
    </div>
  </body>
</html>
