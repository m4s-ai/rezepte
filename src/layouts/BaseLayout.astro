---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Rezepte", description = "Öffentliche Rezepte aus dem Second Brain." } =
  Astro.props;
const pageTitle = title === "Rezepte" ? "Rezepte" : `${title} · Rezepte`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow,noarchive,noimageindex" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
